[Unit]
Description=Ofogheamn DNS — Gaming Smart DNS (SmartDNS core)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ofodns
Group=ofodns
RuntimeDirectory=ofogheamn-dns
ExecStart=/usr/local/bin/smartdns -f -c /etc/ofogheamn-dns/smartdns.conf -p /run/ofogheamn-dns/dns.pid
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/cache/ofogheamn-dns /var/log/ofogheamn-dns
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
