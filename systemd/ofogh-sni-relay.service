[Unit]
Description=Ofogheamn transparent SNI relay for TCP 443 (licensing hosts + DoH)
After=network-online.target ofogheamn-dns.service
Wants=network-online.target

[Service]
Type=simple
User=ofodns
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /usr/local/bin/ofogh-sni-relay.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
