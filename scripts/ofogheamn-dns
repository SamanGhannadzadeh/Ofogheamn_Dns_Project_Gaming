#!/bin/bash
# ============================================================
#  Ofogheamn DNS — management CLI (v2)
#  Run bare for an interactive menu, or use subcommands:
#    status | mode [public|private] | allow list|add|remove <net>
#    hijack list|add <domain> <ip>|remove <domain>
#    game  list|add <domain>|remove <domain>      (gaming list)
#    cod   list|add <domain>|remove <domain>      (CoD list)
#    proxy status|users|add-user <u> <p>|del-user <u>|restart
#    vpn   status|restart|set-user <u> <p>|set-pass <p>|set-psk <psk>
#    panel | panel-password <new> | cod-test | warmup
#    restart | logs [dns|proxy] [n] | test | update | firewall
# ============================================================
set -u
ETC=/etc/ofogheamn-dns
SVC=ofogheamn-dns
if [ -t 1 ]; then B=$'\033[1m'; G=$'\033[32m'; C=$'\033[36m'; R=$'\033[31m'; N=$'\033[0m'; else B=; G=; C=; R=; N=; fi
need_root() { [ "$(id -u)" = "0" ] || { echo "${R}run with sudo${N}"; exit 1; }; }
state() { local s; s="$(systemctl is-active "$1" 2>/dev/null || true)"; echo "${s:-unknown}"; }
# grep -c prints the count AND exits 1 on zero matches, so the
# "$(grep -c ... || echo 0)" idiom printed "0\n0" (v1.4 fix).
cnt() { local n; n="$(grep "$@" 2>/dev/null || true)"; printf '%s' "${n:-0}"; }
# Download integrity, same policy as install.sh: verify against
# the SHA-256 digest GitHub records for the release asset.
verify_digest() { # repo tag asset file
  local want got
  want="$(curl -fsSL --max-time 30 "https://api.github.com/repos/$1/releases/tags/$2" 2>/dev/null \
    | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    a = [x for x in d.get("assets", []) if x["name"] == sys.argv[1]]
    print((a[0].get("digest") or "").replace("sha256:", "") if a else "")
except Exception:
    print("")' "$3" 2>/dev/null || true)"
  if [ -z "$want" ]; then
    echo "WARNING: could not fetch the official digest for $3; installing unverified"
    return 0
  fi
  got="$(sha256sum "$4" | awk '{print $1}')"
  if [ "$got" != "$want" ]; then
    echo "SECURITY ABORT: sha256 mismatch for $3 (got $got, want $want)" >&2
    return 1
  fi
  echo "digest verified: $3"
}
get_mode() { grep -E '^mode=' "$ETC/mode.conf" 2>/dev/null | cut -d= -f2; }
reload_dns() { systemctl restart "$SVC" && echo "${G}DNS reloaded${N}"; }
gen_proxy() { OFOGH_ETC="$ETC" python3 /usr/local/lib/ofogheamn-dns/gen-singbox-config.py || { echo "${R}proxy config generation FAILED — the running proxy was NOT changed${N}" >&2; return 1; }; }
hijack_set() { # <domain> <ipv4> [ipv6] — file edit only; the caller reloads once
  # Fixed-string filter, not sed (v1.33): the domain used to be a
  # regex, so dots matched any character and removing one name
  # could delete a lookalike's rule.
  local tmp; tmp="$(mktemp)"
  grep -vF "address /$1/" "$ETC/hijack.conf" > "$tmp" 2>/dev/null || true
  cat "$tmp" > "$ETC/hijack.conf"; rm -f "$tmp"
  echo "address /$1/$2" >> "$ETC/hijack.conf"
  echo "address /$1/${3:-::}" >> "$ETC/hijack.conf"
}

cmd_status() {
  echo "${B}== Ofogheamn DNS ==${N}"
  echo " DNS service : $(state ofogheamn-dns)   (UDP/TCP 53, DoT 853, DoH 443)"
  echo " Proxy       : $(state ofogheamn-proxy)   (mixed HTTP/SOCKS5 :2080, UDP on)"
  echo " Tunnel (WG) : $(state ofogheamn-wg)   (wg0 :51820/udp, peers: $(ofogheamn-wg-peer list 2>/dev/null | wc -l))"
  echo " VPN         : $(state ofogheamn-vpn)   (L2TP/IPsec + PPTP, user: $(vpn_conf_get user))"
  echo " Panel       : $(state ofogheamn-panel)   (http://<server>:8080)"
  echo " Cache warmer: $(state cod-warmup.timer)   (CoD/gaming lists, every 4 min)"
  echo " Mode        : ${B}$(get_mode)${N}"
  echo " Hijack rules: $(cnt -cE '^(address|cname) ' "$ETC/hijack.conf")"
  echo " CoD domains : $(cnt -cvE '^\s*(#|$)' "$ETC/lists/cod.domains")   Gaming domains: $(cnt -cvE '^\s*(#|$)' "$ETC/lists/gaming.domains")"
  echo " Proxy users : $(python3 -c "import json;print(', '.join(u['user'] for u in json.load(open('$ETC/proxy-users.json'))))" 2>/dev/null || echo -)"
}

cmd_mode() {
  case "${1:-}" in
    public|private)
      need_root; echo "mode=$1" > "$ETC/mode.conf"; bash /usr/local/bin/ofogheamn-firewall ;;
    "") echo "mode: $(get_mode)  (change: ofogheamn-dns mode public|private)" ;;
    *) echo "usage: ofogheamn-dns mode [public|private]"; return 64 ;;
  esac
}

cmd_allow() {
  case "${1:-list}" in
    list) grep -vE '^\s*(#|$)' "$ETC/allowlist.txt" 2>/dev/null || echo "(empty)" ;;
    add) need_root; grep -qxF "$2" "$ETC/allowlist.txt" 2>/dev/null || echo "$2" >> "$ETC/allowlist.txt"; bash /usr/local/bin/ofogheamn-firewall ;;
    remove) need_root
      # Fixed-string, whole-line (v1.33): the sed form treated the
      # IP as a regex — removing 1.2.3.4 also matched 112.3.4.
      tmp="$(mktemp)"; grep -vxF "$2" "$ETC/allowlist.txt" > "$tmp" 2>/dev/null || true
      cat "$tmp" > "$ETC/allowlist.txt"; rm -f "$tmp"
      bash /usr/local/bin/ofogheamn-firewall ;;
    *) echo "usage: ofogheamn-dns allow list|add|remove <ip-or-cidr>"; return 64 ;;
  esac
}

list_op() { # $1=file $2=op $3=domain
  case "$2" in
    list) grep -vE '^\s*(#|$)' "$1" ;;
    add) need_root; grep -qxF "$3" "$1" || echo "$3" >> "$1"; echo "added: $3"; reload_dns ;;
    remove) need_root
      tmp="$(mktemp)"; grep -vxF "$3" "$1" > "$tmp" 2>/dev/null || true
      cat "$tmp" > "$1"; rm -f "$tmp"
      echo "removed: $3"; reload_dns ;;
  esac
}

cmd_proxy() {
  case "${1:-status}" in
    status) echo "proxy: $(state ofogheamn-proxy) on :2080 (mixed HTTP/SOCKS5 + UDP)" ;;
    restart) need_root; systemctl restart ofogheamn-proxy && echo ok ;;
    users) python3 -c "import json;[print(u['user']) for u in json.load(open('$ETC/proxy-users.json'))]" 2>/dev/null || echo "(none)" ;;
    add-user)
      need_root
      [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "usage: ofogheamn-dns proxy add-user <user> <pass>"; return 64; }
      python3 - "$2" "$3" <<'PY'
import json, sys
p = "/etc/ofogheamn-dns/proxy-users.json"
try: users = json.load(open(p))
except Exception: users = []
users = [u for u in users if u["user"] != sys.argv[1]]
users.append({"user": sys.argv[1], "pass": sys.argv[2]})
json.dump(users, open(p, "w"), indent=1)
print("user saved:", sys.argv[1])
PY
      gen_proxy || exit 1; systemctl restart ofogheamn-proxy && echo "${G}proxy reloaded${N}" ;;
    del-user)
      need_root
      [ -n "${2:-}" ] || { echo "usage: ofogheamn-dns proxy del-user <user>"; return 64; }
      python3 - "$2" <<'PY'
import json, sys
p = "/etc/ofogheamn-dns/proxy-users.json"
users = [u for u in json.load(open(p)) if u["user"] != sys.argv[1]]
json.dump(users, open(p, "w"), indent=1)
print("user removed:", sys.argv[1])
PY
      gen_proxy || exit 1; systemctl restart ofogheamn-proxy && echo "${G}proxy reloaded${N}" ;;
    *) echo "usage: ofogheamn-dns proxy status|users|add-user <u> <p>|del-user <u>|restart"; return 64 ;;
  esac
}

vpn_conf_get() { grep -E "^$1=" "$ETC/vpn.conf" 2>/dev/null | cut -d= -f2; }
vpn_conf_set() { # key value — credentials live in vpn.conf only;
  # ofogheamn-vpn-setup renders them into chap-secrets/ipsec.secrets.
  # Rewrite-by-filter (not sed) so passwords with any characters work.
  local kept
  kept="$(grep -vE "^$1=" "$ETC/vpn.conf" 2>/dev/null || true)"
  if [ -n "$kept" ]; then printf '%s\n' "$kept" > "$ETC/vpn.conf"; else : > "$ETC/vpn.conf"; fi
  echo "$1=$2" >> "$ETC/vpn.conf"
  chmod 600 "$ETC/vpn.conf"
}

cmd_vpn() {
  case "${1:-status}" in
    status)
      echo "VPN servers : $(state ofogheamn-vpn)"
      echo " L2TP/IPsec : UDP 500/4500/1701 + ESP — pool $(vpn_conf_get l2tp_pool) — PSK: $(vpn_conf_get psk)"
      echo " PPTP       : TCP 1723 + GRE (MPPE-128 required) — pool $(vpn_conf_get pptp_pool)"
      echo " user       : $(vpn_conf_get user)   (password in $ETC/vpn.conf)"
      echo " ${R}defaults are public — change them: vpn set-user / set-pass / set-psk${N}" ;;
    restart) need_root; systemctl restart ofogheamn-vpn && echo ok ;;
    set-user)
      need_root
      [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "usage: ofogheamn-dns vpn set-user <user> <pass>"; return 64; }
      vpn_conf_set user "$2"; vpn_conf_set pass "$3"
      systemctl restart ofogheamn-vpn && echo "VPN user updated" ;;
    set-pass)
      need_root
      [ -n "${2:-}" ] || { echo "usage: ofogheamn-dns vpn set-pass <new>"; return 64; }
      vpn_conf_set pass "$2"
      systemctl restart ofogheamn-vpn && echo "VPN password updated" ;;
    set-psk)
      need_root
      [ -n "${2:-}" ] || { echo "usage: ofogheamn-dns vpn set-psk <new>"; return 64; }
      vpn_conf_set psk "$2"
      systemctl restart ofogheamn-vpn && echo "IPsec PSK updated" ;;
    *) echo "usage: ofogheamn-dns vpn status|restart|set-user <u> <p>|set-pass <p>|set-psk <psk>"; return 64 ;;
  esac
}

menu() {
  while true; do
    echo; echo "${B}${C}🌐 Ofogheamn DNS — منوی مدیریت${N}"
    echo " 1) وضعیت کامل        2) ری‌استارت DNS      3) ری‌استارت پروکسی"
    echo " 4) حالت عمومی/خصوصی  5) قوانین هایجک        6) تست کالاف (cod-test)"
    echo " 7) لاگ DNS           8) کاربران پروکسی      9) گرم‌کردن کش"
    echo " 0) خروج"
    printf " انتخاب: "; read -r ch
    case "$ch" in
      1) cmd_status ;;
      2) need_root; reload_dns ;;
      3) cmd_proxy restart ;;
      4) printf "حالت جدید (public/private): "; read -r m; cmd_mode "$m";
         printf "شبکهٔ مجاز برای حالت خصوصی (CIDR، خالی = رد): "; read -r net; [ -n "$net" ] && cmd_allow add "$net" ;;
      5) grep -E '^(address|cname) ' "$ETC/hijack.conf" || echo "(none)";
         printf "افزودن: domain ip (خالی = رد): "; read -r d ip; [ -n "${d:-}" ] && [ -n "${ip:-}" ] && $0 add-hijack "$d" "$ip" ;;
      6) $0 cod-test ;;
      7) tail -n 30 /var/log/ofogheamn-dns/smartdns.log ;;
      8) cmd_proxy users; printf "کاربر جدید (user pass، خالی = رد): "; read -r u p; [ -n "${u:-}" ] && [ -n "${p:-}" ] && cmd_proxy add-user "$u" "$p" ;;
      9) need_root; systemctl start cod-warmup.service && echo ok ;;
      0) break ;;
      *) echo "?" ;;
    esac
  done
}

case "${1:-menu}" in
  menu) [ -t 0 ] && menu || cmd_status ;;
  status) cmd_status ;;
  mode) shift; cmd_mode "${1:-}" ;;
  allow) shift; cmd_allow "$@" ;;
  firewall) need_root; bash /usr/local/bin/ofogheamn-firewall ;;
  panel) echo "Panel: http://$(hostname -I | awk '{print $1}'):8080  (state: $(state ofogheamn-panel))" ;;
  panel-password)
    need_root
    [ -n "${2:-}" ] || { echo "usage: ofogheamn-dns panel-password <new>"; exit 64; }
    python3 - "$2" <<'PY'
import hashlib, sys
h = hashlib.sha256(sys.argv[1].encode()).hexdigest()
lines = []
try: lines = [l for l in open("/etc/ofogheamn-dns/panel.conf").read().splitlines() if not l.startswith("password_hash=")]
except OSError: lines = ["port=8080", "bind=0.0.0.0"]
lines.append("password_hash=" + h)
open("/etc/ofogheamn-dns/panel.conf", "w").write("\n".join(lines) + "\n")
print("panel password updated")
PY
    systemctl restart ofogheamn-panel 2>/dev/null || true ;;
  proxy) shift; cmd_proxy "$@" ;;
  vpn) shift; cmd_vpn "$@" ;;
  region) python3 /usr/local/bin/ofogheamn-region.py "${2:-}" ;;
  bench) python3 /usr/local/bin/ofogheamn-bench.py "${2:-}" ;;
  health) python3 /usr/local/bin/ofogheamn-health.py "${2:-}" ;;
  backup)
    need_root
    out="/var/backups/ofogheamn-$(date +%Y%m%d-%H%M%S).tar.gz"
    mkdir -p /var/backups
    tar -czf "$out" -C / etc/ofogheamn-dns 2>/dev/null
    chmod 600 "$out"
    echo "backup: $out" ;;
  restore)
    need_root
    [ -n "${2:-}" ] && [ -f "$2" ] || { echo "usage: ofogheamn-dns restore <backup.tar.gz>"; exit 1; }
    tar -xzf "$2" -C / && reload_dns && echo "restored from: $2" ;;
  console)
    shift
    case "${1:-status}" in
      enable)
        need_root
        CPORT="${2:-2081}"
        python3 - "$CPORT" <<'PY'
import json, sys, os
p = "/etc/ofogheamn-dns/console.json"
with open(p, "w") as fh: json.dump({"port": int(sys.argv[1])}, fh)
os.chmod(p, 0o600)
print("console port enabled:", sys.argv[1])
PY
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true
        MODE_NOW="$(grep -E '^mode=' "$ETC/mode.conf" 2>/dev/null | cut -d= -f2)"
        echo "PS5/Xbox: proxy = this server's IP, port $CPORT, no user/pass."
        [ "$MODE_NOW" = "private" ] || echo "WARNING: mode is not private — the firewall BLOCKS the console port in public mode. Run: ofogheamn-dns mode private" ;;
      disable)
        need_root; rm -f /etc/ofogheamn-dns/console.json
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true
        echo "console port disabled" ;;
      *) if [ -f /etc/ofogheamn-dns/console.json ]; then echo "console: on (port $(python3 -c "import json;print(json.load(open('/etc/ofogheamn-dns/console.json'))['port'])" 2>/dev/null || echo 2081))"; else echo "console: off"; fi ;;
    esac ;;
  ddns)
    shift
    case "${1:-status}" in
      set)
        need_root
        [ -n "${2:-}" ] || { echo "usage: ofogheamn-dns ddns set <hostname>" ; exit 1; }
        printf '%s\n' "$2" > /etc/ofogheamn-dns/ddns.conf
        chmod 600 /etc/ofogheamn-dns/ddns.conf
        systemctl enable --now ofogh-ddns.timer >/dev/null 2>&1 || true
        /usr/local/bin/ofogh-ddns-allowlist || true
        echo "ddns: $2 — the node follows this hostname's IP in the allowlist (checked every 5 min)" ;;
      clear)
        need_root
        if [ -f /etc/ofogheamn-dns/ddns-state.txt ] && [ -f /etc/ofogheamn-dns/allowlist.txt ]; then
          grep -vxF -f /etc/ofogheamn-dns/ddns-state.txt /etc/ofogheamn-dns/allowlist.txt > /etc/ofogheamn-dns/allowlist.tmp || true
          mv /etc/ofogheamn-dns/allowlist.tmp /etc/ofogheamn-dns/allowlist.txt
          bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true
        fi
        rm -f /etc/ofogheamn-dns/ddns.conf /etc/ofogheamn-dns/ddns-state.txt
        systemctl disable --now ofogh-ddns.timer >/dev/null 2>&1 || true
        echo "ddns cleared (the IPs it had added were removed from the allowlist)" ;;
      *) if [ -f /etc/ofogheamn-dns/ddns.conf ]; then echo "ddns: $(cat /etc/ofogheamn-dns/ddns.conf) (current IPs: $(paste -sd, /etc/ofogheamn-dns/ddns-state.txt 2>/dev/null || echo none))"; else echo "ddns: off"; fi ;;
    esac ;;
  reality)
    shift
    case "${1:-status}" in
      enable)
        need_root
        command -v sing-box >/dev/null || { echo "sing-box not installed"; exit 1; }
        # Re-running enable must not rotate the keypair (v1.33): it
        # used to mint fresh keys unconditionally, silently
        # invalidating every client config already handed out.
        if [ -f /etc/ofogheamn-dns/reality.json ]; then
          echo "REALITY already enabled — keeping the existing keypair (client configs stay valid)"
        else
        KP="$(sing-box generate reality-keypair)"
        PRIV="$(printf '%s' "$KP" | awk '/PrivateKey/{print $2}')"
        PUB="$(printf '%s' "$KP" | awk '/PublicKey/{print $2}')"
        SID="$(head -c4 /dev/urandom | od -An -tx1 | tr -d ' \n')"
        python3 - "$PRIV" "$PUB" "$SID" <<'PY'
import json, sys, os
cfg = {"private_key": sys.argv[1], "public_key": sys.argv[2],
       "short_id": sys.argv[3], "server_name": "www.microsoft.com",
       "port": 4443}
p = "/etc/ofogheamn-dns/reality.json"
with open(p, "w") as fh: json.dump(cfg, fh, indent=2)
os.chmod(p, 0o600)
print("REALITY enabled on :4443 — client needs: public_key=" + sys.argv[2]
      + " short_id=" + sys.argv[3] + " sni=www.microsoft.com")
PY
        fi
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true ;;
      disable)
        need_root; rm -f /etc/ofogheamn-dns/reality.json
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true; echo "REALITY disabled" ;;
      *) [ -f /etc/ofogheamn-dns/reality.json ] && echo "REALITY: on" || echo "REALITY: off" ;;
    esac ;;
  hysteria2)
    shift
    case "${1:-status}" in
      enable)
        need_root
        command -v sing-box >/dev/null || { echo "sing-box not installed"; exit 1; }
        HPORT="${2:-443}"
        PW="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
        python3 - "$PW" "$HPORT" <<'PY'
import json, sys, os
p = "/etc/ofogheamn-dns/hysteria2.json"
cfg = {}
if os.path.exists(p):
    cfg = json.load(open(p))  # keep the existing password on re-enable (v1.33)
cfg["port"] = int(sys.argv[2])
cfg.setdefault("password", sys.argv[1])
with open(p, "w") as fh: json.dump(cfg, fh, indent=2)
os.chmod(p, 0o600)
print("hysteria2 enabled on udp/" + sys.argv[2])
print("client URI: hysteria2://<password>@<server>:" + sys.argv[2] + "/?insecure=1")
print("the password is stored in " + p + " (mode 600)")
PY
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true ;;
      disable)
        need_root; rm -f /etc/ofogheamn-dns/hysteria2.json
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true
        echo "Hysteria2 disabled" ;;
      hop)
        need_root
        python3 - "${2:-off}" <<'PY'
import json, sys, os
p = "/etc/ofogheamn-dns/hysteria2.json"
if not os.path.exists(p):
    print("hysteria2 is not enabled; run: ofogheamn-dns hysteria2 enable"); sys.exit(1)
cfg = json.load(open(p))
if sys.argv[1] == "off":
    cfg.pop("hop_range", None); print("port hopping off")
else:
    cfg["hop_range"] = sys.argv[1]
    print("port hopping on: udp/" + sys.argv[1] + " -> " + str(cfg["port"]))
json.dump(cfg, open(p, "w"), indent=2); os.chmod(p, 0o600)
PY
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true ;;
      obfs)
        need_root
        python3 - "${2:-gecko}" <<'PY'
import json, sys, os, secrets
p = "/etc/ofogheamn-dns/hysteria2.json"
if not os.path.exists(p):
    print("hysteria2 is not enabled; run: ofogheamn-dns hysteria2 enable"); sys.exit(1)
cfg = json.load(open(p))
if sys.argv[1] == "off":
    cfg.pop("obfs", None); cfg.pop("obfs_password", None); print("obfs off")
else:
    cfg["obfs"] = sys.argv[1]
    cfg.setdefault("obfs_password", secrets.token_hex(16))
    print("obfs:", sys.argv[1], "(password in " + p + ")")
json.dump(cfg, open(p, "w"), indent=2); os.chmod(p, 0o600)
PY
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true ;;
      *) [ -f /etc/ofogheamn-dns/hysteria2.json ] && echo "Hysteria2: on" || echo "Hysteria2: off" ;;
    esac ;;
  hysteria2-gecko)
    shift
    case "${1:-status}" in
      enable)
        need_root
        command -v sing-box >/dev/null || { echo "sing-box not installed"; exit 1; }
        GPORT="${2:-2083}"
        python3 - "$GPORT" <<'PY'
import json, sys, os, secrets
p = "/etc/ofogheamn-dns/hysteria2-gecko.json"
# Reuse the main Hysteria2 user password when there is one, so a
# client keeps a single password across both hy2 listeners.
pw = None
main = "/etc/ofogheamn-dns/hysteria2.json"
if os.path.exists(main):
    pw = json.load(open(main)).get("password")
old = {}
if os.path.exists(p):
    old = json.load(open(p))  # keep existing secrets on re-enable (v1.33)
cfg = {"port": int(sys.argv[1]),
       "password": old.get("password") or pw or secrets.token_hex(16),
       "obfs_password": old.get("obfs_password") or secrets.token_hex(16),
       "min_packet_size": 512, "max_packet_size": 1200}
with open(p, "w") as fh: json.dump(cfg, fh, indent=2)
os.chmod(p, 0o600)
print("hysteria2-gecko enabled on udp/" + sys.argv[1] + " (parallel to the main Hysteria2; existing clients untouched)")
print("passwords are stored in " + p + " (mode 600)")
PY
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true ;;
      disable)
        need_root; rm -f /etc/ofogheamn-dns/hysteria2-gecko.json
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true
        echo "Hysteria2-Gecko disabled" ;;
      *) [ -f /etc/ofogheamn-dns/hysteria2-gecko.json ] && echo "Hysteria2-Gecko: on" || echo "Hysteria2-Gecko: off" ;;
    esac ;;
  tuic)
    shift
    case "${1:-status}" in
      enable)
        need_root
        command -v sing-box >/dev/null || { echo "sing-box not installed"; exit 1; }
        TPORT="${2:-8443}"
        python3 - "$TPORT" <<'PY'
import json, sys, os, uuid, secrets
p = "/etc/ofogheamn-dns/tuic.json"
cfg = {}
if os.path.exists(p):
    cfg = json.load(open(p))  # keep uuid/password on re-enable (v1.33)
cfg["port"] = int(sys.argv[1])
cfg.setdefault("uuid", str(uuid.uuid4()))
cfg.setdefault("password", secrets.token_hex(16))
with open(p, "w") as fh: json.dump(cfg, fh, indent=2)
os.chmod(p, 0o600)
print("tuic v5 enabled on udp/" + sys.argv[1] + " (BBR, 0-RTT off)")
print("uuid + password are stored in " + p + " (mode 600)")
PY
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true ;;
      disable)
        need_root; rm -f /etc/ofogheamn-dns/tuic.json
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true
        echo "TUIC disabled" ;;
      *) [ -f /etc/ofogheamn-dns/tuic.json ] && echo "TUIC: on" || echo "TUIC: off" ;;
    esac ;;
  anytls)
    shift
    case "${1:-status}" in
      enable)
        need_root
        command -v sing-box >/dev/null || { echo "sing-box not installed"; exit 1; }
        APORT="${2:-8443}"
        PW="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
        python3 - "$PW" "$APORT" <<'PY'
import json, sys, os
p = "/etc/ofogheamn-dns/anytls.json"
cfg = {}
if os.path.exists(p):
    cfg = json.load(open(p))  # keep the existing password on re-enable (v1.33)
cfg["port"] = int(sys.argv[2])
cfg.setdefault("password", sys.argv[1])
with open(p, "w") as fh: json.dump(cfg, fh, indent=2)
os.chmod(p, 0o600)
print("anytls enabled on tcp/" + sys.argv[2])
print("the password is stored in " + p + " (mode 600)")
PY
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true ;;
      disable)
        need_root; rm -f /etc/ofogheamn-dns/anytls.json
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true
        echo "AnyTLS disabled" ;;
      *) [ -f /etc/ofogheamn-dns/anytls.json ] && echo "AnyTLS: on" || echo "AnyTLS: off" ;;
    esac ;;
  https-proxy)
    shift
    case "${1:-status}" in
      enable)
        need_root
        command -v sing-box >/dev/null || { echo "sing-box not installed"; exit 1; }
        HPORT="${2:-9443}"
        python3 - "$HPORT" <<'PY'
import json, sys, os
p = "/etc/ofogheamn-dns/https-proxy.json"
with open(p, "w") as fh: json.dump({"port": int(sys.argv[1])}, fh)
os.chmod(p, 0o600)
print("https-proxy enabled on tcp/" + sys.argv[1])
PY
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true ;;
      disable)
        need_root; rm -f /etc/ofogheamn-dns/https-proxy.json
        gen_proxy || exit 1
        systemctl restart ofogheamn-proxy 2>/dev/null || true
        bash /usr/local/bin/ofogheamn-firewall >/dev/null 2>&1 || true
        echo "HTTPS proxy disabled" ;;
      *) [ -f /etc/ofogheamn-dns/https-proxy.json ] && echo "HTTPS proxy: on" || echo "HTTPS proxy: off" ;;
    esac ;;
  recursive)
    shift
    case "${1:-status}" in
      enable)
        need_root
        command -v unbound >/dev/null || { echo "the recursive back-end needs the unbound package first:"; echo "  apt-get install -y unbound"; echo "(its config and systemd unit are already installed by this project)"; exit 1; }
        printf '# managed by: ofogheamn-dns recursive enable\nserver 127.0.0.1:5335 -group recursive\n' > "$ETC/recursive.conf"
        systemctl enable --now ofogheamn-recursive 2>/dev/null || true
        reload_dns
        echo "recursive back-end on: local Unbound (127.0.0.1:5335) now races the public upstreams" ;;
      disable)
        need_root
        printf '# recursive back-end off (ships inert — see config/recursive.conf in the repo)\n' > "$ETC/recursive.conf"
        systemctl disable --now ofogheamn-recursive 2>/dev/null || true
        reload_dns
        echo "recursive back-end off" ;;
      *) grep -q '^server ' "$ETC/recursive.conf" 2>/dev/null && echo "Recursive: on" || echo "Recursive: off" ;;
    esac ;;
  wg)
    shift
    case "${1:-status}" in
      status) wg show wg0 2>/dev/null || echo "tunnel wg0 is down" ;;
      add-peer) need_root; [ -n "${2:-}" ] || { echo "usage: ofogheamn-dns wg add-peer <name>"; exit 64; }; ofogheamn-wg-peer add "$2"; systemctl restart ofogheamn-wg && echo "${G}tunnel reloaded — send the config above to the device${N}" ;;
      peers) ofogheamn-wg-peer list ;;
      del-peer) need_root; [ -n "${2:-}" ] || { echo "usage: ofogheamn-dns wg del-peer <name>"; exit 64; }; ofogheamn-wg-peer remove "$2"; systemctl restart ofogheamn-wg && echo ok ;;
      restart) need_root; systemctl restart ofogheamn-wg && echo ok ;;
      *) echo "usage: ofogheamn-dns wg status|add-peer <name>|peers|del-peer <name>|restart" ;;
    esac ;;
  mesh)
    shift
    MCONF="$ETC/mesh.json"
    mesh_py() { python3 - "$@" <<'PYEOF'
import json, sys, os
p = "/etc/ofogheamn-dns/mesh.json"
try: c = json.load(open(p))
except Exception: c = {}
c.setdefault("enabled", False); c.setdefault("peers", [])
c.setdefault("port", 51821); c.setdefault("wg_port", 51822)
cmd = sys.argv[1]
if cmd == "init":
    import secrets
    if not c.get("key"): c["key"] = secrets.token_hex(16)
    if not c.get("mesh_ip"): c["mesh_ip"] = "10.99.0.1"
    json.dump(c, open(p, "w"), indent=1); print("mesh key:", c["key"])
elif cmd == "on": c["enabled"] = True; json.dump(c, open(p, "w"), indent=1); print("mesh ON")
elif cmd == "off": c["enabled"] = False; json.dump(c, open(p, "w"), indent=1); print("mesh OFF")
elif cmd == "key":
    if len(sys.argv) > 2: c["key"] = sys.argv[2]; json.dump(c, open(p, "w"), indent=1)
    print("mesh key:", c.get("key", ""))
elif cmd == "add-peer":
    name, ep, pub, ip = sys.argv[2:6]
    c["peers"] = [x for x in c["peers"] if x["name"] != name]
    c["peers"].append({"name": name, "endpoint": ep, "pubkey": pub, "mesh_ip": ip})
    json.dump(c, open(p, "w"), indent=1); print("peer added:", name)
elif cmd == "del-peer":
    c["peers"] = [x for x in c["peers"] if x["name"] != sys.argv[2]]
    json.dump(c, open(p, "w"), indent=1); print("peer removed:", sys.argv[2])
elif cmd == "peers":
    for x in c["peers"]: print(" %s  %s  %s" % (x["name"], x["endpoint"], x["mesh_ip"]))
    if not c["peers"]: print(" (no peers)")
elif cmd == "status":
    print("mesh:", "ON" if c["enabled"] else "OFF", " peers:", len(c["peers"]))
    try: print(open("/run/ofogheamn-mesh-state.json").read())
    except Exception: print(" (agent has not reported yet)")
PYEOF
    }
    case "${1:-status}" in
      on) need_root; [ -f "$MCONF" ] || mesh_py init >/dev/null; mesh_py on; systemctl enable --now ofogheamn-mesh && echo "${G}mesh agent running${N}" ;;
      off) need_root; mesh_py off; systemctl disable --now ofogheamn-mesh; echo ok ;;
      init) need_root; mesh_py init ;;
      key) mesh_py key "$2" ;;
      add-peer) need_root; mesh_py add-peer "$2" "$3" "$4" "$5"; systemctl restart ofogheamn-mesh 2>/dev/null; echo ok ;;
      del-peer) need_root; mesh_py del-peer "$2"; systemctl restart ofogheamn-mesh 2>/dev/null; echo ok ;;
      peers) mesh_py peers ;;
      status) mesh_py status ;;
      *) echo "usage: ofogheamn-dns mesh on|off|status|init|key [value]|add-peer <name> <host:wgport> <pubkey> <mesh-ip>|del-peer <name>|peers" ;;
    esac ;;
  edge-pins)
    case "${2:-show}" in
      run) need_root; /usr/local/bin/ofogh-edge-pins run ;;
      show) cat /etc/ofogheamn-dns/edge-pin.conf 2>/dev/null || echo "(no edge pins yet)" ;;
      *) echo "usage: ofogheamn-dns edge-pins [run|show]"; exit 64 ;;
    esac ;;
  restart) need_root; reload_dns ;;
  start) need_root; systemctl start "$SVC" ;;
  stop) need_root; systemctl stop "$SVC" ;;
  logs) case "${2:-dns}" in
          dns) lf=smartdns ;; proxy) lf=singbox ;; *) lf="${2:-smartdns}" ;;
        esac
        tail -n "${3:-50}" "/var/log/ofogheamn-dns/$lf.log" 2>/dev/null || tail -n "${3:-50}" /var/log/ofogheamn-dns/smartdns.log ;;
  sni-relay)
    shift
    case "${1:-status}" in
      enable)
        need_root
        sed -i 's|^bind-https \[::\]:443|bind-https 127.0.0.1:10443|' /etc/ofogheamn-dns/smartdns.conf
        # Post-check (v1.33): a hand-edited bind line used to make
        # this sed silently no-op while the CLI still claimed the
        # relay was on.
        grep -q '^bind-https 127.0.0.1:10443' /etc/ofogheamn-dns/smartdns.conf \
          || { echo "ABORT: the bind-https line in smartdns.conf did not move to 127.0.0.1:10443 (hand-edited?); fix it manually first" >&2; exit 1; }
        python3 - <<'PY'
import json, os
p = "/etc/ofogheamn-dns/sni-relay.json"
cfg = {"suffixes": ["embodyvr.io", "demonware.net",
                    "public-ubiservices.ubi.com",
                    "channel-service.upc.ubi.com", "account.ubisoft.com",
                    "accounts.ea.com", "signin.ea.com", "gateway.ea.com",
                    "api.stumbleguys.com",
                    "fenrir-resolver-spacetime.aprod.scopely.io",
                    "raven-spacetime.aprod.scopely.io"], "doh_names": []}
if os.path.exists(p):
    cfg.update(json.load(open(p)))
with open(p, "w") as fh: json.dump(cfg, fh, indent=2)
os.chmod(p, 0o600)
# The relay runs as user ofodns (v1.33): a root-owned 600 config
# is unreadable to it, and the relay then silently falls back to
# its compiled-in defaults — the operator's suffixes never apply.
try:
    import pwd
    u = pwd.getpwnam("ofodns")
    os.chown(p, u.pw_uid, u.pw_gid)
except Exception:
    pass  # no ofodns user on this host; root-run units read it fine
print("SNI relay config:", p)
PY
        # Order matters (v1.33): free :443 (restart SmartDNS onto
        # its new loopback DoH bind) BEFORE starting the relay —
        # starting the relay first always collided with SmartDNS
        # and only the unit's Restart=on-failure rescued it.
        systemctl restart ofogheamn-dns
        systemctl enable --now ofogh-sni-relay
        echo "SNI relay on: TCP/443 routes by SNI; DoH moved to 127.0.0.1:10443."
        echo "Point a licensing host at this node: ofogheamn-dns add-hijack <host> <node-ip>"
        echo "(the host must sit under a suffix in sni-relay.json; default: embodyvr.io)" ;;
      disable)
        need_root
        sed -i 's|^bind-https 127.0.0.1:10443|bind-https [::]:443|' /etc/ofogheamn-dns/smartdns.conf
        systemctl disable --now ofogh-sni-relay 2>/dev/null || true
        systemctl restart ofogheamn-dns
        echo "SNI relay off: DoH is back on [::]:443" ;;
      *) { [ -f /etc/ofogheamn-dns/sni-relay.json ] && systemctl is-active ofogh-sni-relay >/dev/null 2>&1; } && echo "SNI relay: on" || echo "SNI relay: off" ;;
    esac ;;
  mm-relay)
    shift
    case "${1:-status}" in
      enable)
        need_root
        python3 - <<'PY'
import json, os
p = "/etc/ofogheamn-dns/mm-relay.json"
cfg = {"host": "lsg.7500.prod.demonware.net", "port": 3074}
if os.path.exists(p):
    cfg.update(json.load(open(p)))
with open(p, "w") as fh: json.dump(cfg, fh, indent=2)
os.chmod(p, 0o600)
# Same ofodns readability fix as the SNI relay config (v1.33).
try:
    import pwd
    u = pwd.getpwnam("ofodns")
    os.chown(p, u.pw_uid, u.pw_gid)
except Exception:
    pass  # no ofodns user on this host; root-run units read it fine
print("matchmaking relay config:", p)
PY
        systemctl enable --now ofogh-mm-relay
        /usr/local/bin/ofogheamn-firewall || true
        echo "Matchmaking relay on (TCP 3074 -> real Demonware gateway)."
        echo "Now point the name at this node: ofogheamn-dns add-hijack lsg.7500.prod.demonware.net <node-public-ip>" ;;
      disable)
        need_root; rm -f /etc/ofogheamn-dns/mm-relay.json
        systemctl disable --now ofogh-mm-relay 2>/dev/null || true
        /usr/local/bin/ofogheamn-firewall || true
        echo "Matchmaking relay off (remove its add-hijack line too, if you added one)" ;;
      *) [ -f /etc/ofogheamn-dns/mm-relay.json ] && echo "MM relay: on" || echo "MM relay: off" ;;
    esac ;;
  add-hijack)
    need_root
    if [ "${2:-}" = "--file" ]; then
      [ -n "${3:-}" ] && [ -n "${4:-}" ] || { echo "usage: ofogheamn-dns add-hijack --file <domains.txt> <ipv4> [ipv6]"; exit 64; }
      while read -r d; do case "$d" in ''|'#'*) continue ;; esac; hijack_set "$d" "$4" "${5:-}"; echo "hijack: $d -> $4"; done < "$3"
      reload_dns
    else
      [ -n "${2:-}" ] && [ -n "${3:-}" ] || { echo "usage: ofogheamn-dns add-hijack <domain> <ipv4> [ipv6]"; exit 64; }
      hijack_set "$2" "$3" "${4:-}"
      echo "hijack: $2 -> $3 (AAAA: ${4:-::, answered locally})"; reload_dns
    fi ;;
  remove-hijack) need_root; sed -i "\#^address /$2/#d" "$ETC/hijack.conf"; echo "removed: $2"; reload_dns ;;
  list-hijack) grep -E "^(address|cname)" "$ETC/hijack.conf" || echo "(none)" ;;
  add-game) list_op "$ETC/lists/gaming.domains" add "$2" ;;
  remove-game) list_op "$ETC/lists/gaming.domains" remove "$2" ;;
  list-games) list_op "$ETC/lists/gaming.domains" list ;;
  game) shift; list_op "$ETC/lists/gaming.domains" "${1:-list}" "${2:-}" ;;
  cod) shift; list_op "$ETC/lists/cod.domains" "${1:-list}" "${2:-}" ;;
  warmup) need_root; systemctl start cod-warmup.service && echo ok ;;
  cod-test)
    echo "Call of Duty / Warzone — winning endpoints right now:"
    for d in demonware.net callofduty.com battle.net activision.com; do
      printf "%-18s -> " "$d"
      dig +short +time=3 +tries=1 @127.0.0.1 "$d" A 2>/dev/null | head -1
      dig +stats @127.0.0.1 "$d" A 2>/dev/null | awk '/Query time/{print "   answer time: " $4 " ms"}'
    done ;;
  test)
    echo "-- UDP/53 --"; dig +stats @127.0.0.1 callofduty.com A 2>/dev/null | grep -E "Query time" || echo "no answer"
    echo "-- cached --"; dig +stats @127.0.0.1 callofduty.com A 2>/dev/null | grep -E "Query time" || true
    echo "-- TCP/53 --"; dig +tcp +stats @127.0.0.1 store.steampowered.com A 2>/dev/null | grep -E "Query time" || echo "no answer"
    echo "-- DoT/853 --"; echo | openssl s_client -connect 127.0.0.1:853 2>/dev/null | grep -E "Verify return code" || echo "DoT not answering"
    echo "-- DoH/443 --"; curl -sk --max-time 5 --doh-url https://127.0.0.1/dns-query --doh-insecure https://example.com -o /dev/null -w "doh http %{http_code}\n" || echo "DoH not answering"
    echo "-- Proxy/2080 --"; curl -s --max-time 5 -x socks5h://127.0.0.1:2080 https://example.com -o /dev/null -w "proxy http %{http_code} (401/auth expected without user)\n" || echo "proxy not answering" ;;
  update)
    need_root
    TAG="$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/pymumu/smartdns/releases/latest | sed 's#.*/tag/##')"
    [ -n "$TAG" ] || { echo "could not determine the latest SmartDNS release (network?)"; exit 1; }
    case "$(uname -m)" in
      x86_64) A=x86_64; SB_ARCH=amd64 ;;
      aarch64|arm64) A=aarch64; SB_ARCH=arm64 ;;
      *) echo "unsupported arch: $(uname -m)"; exit 1 ;;
    esac
    echo "updating SmartDNS core -> $TAG"
    # Keep the previous cores (v1.33): an update used to replace
    # both binaries in place with nothing to roll back to.
    [ -x /usr/local/bin/smartdns ] && cp -a /usr/local/bin/smartdns /usr/local/bin/smartdns.bak || true
    [ -x /usr/local/bin/sing-box ] && cp -a /usr/local/bin/sing-box /usr/local/bin/sing-box.bak || true
    curl -fsSL -o /usr/local/bin/smartdns.new "https://github.com/pymumu/smartdns/releases/download/$TAG/smartdns-$A" \
      && verify_digest "pymumu/smartdns" "$TAG" "smartdns-$A" /usr/local/bin/smartdns.new \
      && chmod 755 /usr/local/bin/smartdns.new && mv /usr/local/bin/smartdns.new /usr/local/bin/smartdns \
      || { rm -f /usr/local/bin/smartdns.new; echo "SmartDNS update failed; keeping the current core"; exit 1; }
    STAG="$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/SagerNet/sing-box/releases/latest | sed 's#.*/tag/##')"
    [ -n "$STAG" ] || { echo "could not determine the latest sing-box release (network?)"; exit 1; }
    echo "updating sing-box -> $STAG"
    # The asset name is arch-specific: this used to hardcode
    # linux-amd64 and install an x86_64 proxy on ARM nodes, and
    # updates were never digest-checked (v1.4 fixes).
    curl -fsSL -o /tmp/sing-box-update.tar.gz "https://github.com/SagerNet/sing-box/releases/download/$STAG/sing-box-${STAG#v}-linux-$SB_ARCH.tar.gz" \
      && verify_digest "SagerNet/sing-box" "$STAG" "sing-box-${STAG#v}-linux-$SB_ARCH.tar.gz" /tmp/sing-box-update.tar.gz \
      && tar -xzf /tmp/sing-box-update.tar.gz -C /tmp \
      && install -m 755 "/tmp/sing-box-${STAG#v}-linux-$SB_ARCH/sing-box" /usr/local/bin/sing-box.new \
      && /usr/local/bin/sing-box.new check -c /etc/ofogheamn-dns/singbox.json \
      && mv /usr/local/bin/sing-box.new /usr/local/bin/sing-box \
      || { rm -f /usr/local/bin/sing-box.new; echo "sing-box update failed or the new core rejects the current config; keeping the current proxy"; exit 1; }
    rm -f /tmp/sing-box-update.tar.gz
    reload_dns; systemctl restart ofogheamn-proxy
    sleep 1
    if ! systemctl is-active ofogheamn-proxy >/dev/null 2>&1 && [ -x /usr/local/bin/sing-box.bak ]; then
      echo "the new sing-box did not come up — rolling back to the previous binary"
      cp -a /usr/local/bin/sing-box.bak /usr/local/bin/sing-box
      systemctl restart ofogheamn-proxy || true
    fi ;;
  *) sed -n '2,12p' "$0" ;;
esac
